<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="AI 聊天" android:textSize="24sp" android:textStyle="bold" />

    <Switch android:id="@+id/float_switch" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="悬浮窗（可开关）" />

    <TextView android:id="@+id/tv_process" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="进程查看：授权 Shizuku / Dhizuku 后可获取系统进程信息" />
</LinearLayout>
