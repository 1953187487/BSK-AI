<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="AI 聊天" android:textSize="24sp" android:textStyle="bold" />

        <Switch android:id="@+id/float_switch" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="悬浮窗（可开关）" android:layout_marginTop="12dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="悬浮窗开启后可查看系统进程、使用 AI 快捷对话。" android:layout_marginTop="8dp"
            android:textColor="#666666" />

        <Button android:id="@+id/btn_process" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="查看系统进程" android:layout_marginTop="16dp" />

        <TextView android:id="@+id/tv_process" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="进程查看：授权 Shizuku / Dhizuku 后可获取更多系统进程信息"
            android:layout_marginTop="8dp" android:textSize="12sp" android:typeface="monospace" />

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="#DDDDDD" android:layout_marginTop="24dp" />

        <TextView android:id="@+id/tv_version" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="当前版本 v0.1" android:layout_marginTop="12dp" />

        <Button android:id="@+id/btn_check_update" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="检查更新" android:layout_marginTop="8dp" />
    </LinearLayout>
</ScrollView>
