<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="设置" android:textSize="24sp" android:textStyle="bold" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="主题颜色" android:textSize="16sp" android:layout_marginTop="16dp" />

        <EditText android:id="@+id/et_theme_color" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="如 #FF6B6B"
            android:inputType="text" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="字体" android:textSize="16sp" android:layout_marginTop="16dp" />

        <Button android:id="@+id/btn_import_font" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="导入字体" />

        <TextView android:id="@+id/tv_font_path" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="未导入字体"
            android:layout_marginTop="8dp" android:textSize="12sp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="权限授权" android:textSize="16sp" android:layout_marginTop="24dp" />

        <CheckBox android:id="@+id/cb_shizuku" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="授权 Shizuku（进程查看）" />

        <CheckBox android:id="@+id/cb_dhizuku" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="授权 Dhizuku" />

        <Button android:id="@+id/btn_save_settings" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="保存设置" android:layout_marginTop="24dp" />

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="#DDDDDD" android:layout_marginTop="24dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="关于" android:textSize="16sp" android:layout_marginTop="16dp" />

        <Button android:id="@+id/btn_check_update_settings" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="检查更新" android:layout_marginTop="8dp" />

        <Button android:id="@+id/btn_open_repo" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="打开开源仓库" android:layout_marginTop="8dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="FloatAI v0.1 · MIT License · Android 8~14"
            android:layout_marginTop="24dp" android:layout_gravity="center"
            android:textColor="#999999" android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
