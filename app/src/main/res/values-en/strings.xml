    <!-- What\'s new -->
    <string name="whatsnew_title">What\'s new</string>
    <string name="whatsnew_updated">Updated to v%1$s</string>
    <string name="whatsnew_start">Get started</string>
    <string name="whatsnew_item_brand">New brand: LingXi</string>
    <string name="whatsnew_item_brand_desc">Renamed with a redesigned icon and palette. The package is now com.lingxi.ai, so uninstall the previous version first.</string>
    <string name="whatsnew_item_privilege">Shizuku / Dhizuku dual privilege</string>
    <string name="whatsnew_item_privilege_desc">Added Dhizuku (DeviceOwner shared privilege) alongside Shizuku. The terminal auto-dispatches over LOCAL, SHIZUKU, DHIZUKU and ROOT.</string>
    <string name="whatsnew_item_ai">Stronger AI kernel</string>
    <string name="whatsnew_item_ai_desc">Token-budgeted context, per-tool timeouts and output truncation, cancellation support, plus new system_info and current_time tools.</string>
    <string name="whatsnew_item_slash">New slash commands</string>
    <string name="whatsnew_item_slash_desc">Added /compact to trim the conversation and /history for statistics. Tool failures are fed back to the model.</string>
    <string name="whatsnew_item_stability">Stability and rendering fixes</string>
    <string name="whatsnew_item_stability_desc">Glass panels are now drawn with pure Compose, removing per-panel shader dependency, and fixes the onboarding first-frame crash plus overlapping layouts.</string>
    <string name="whatsnew_item_i18n">Localized UI</string>
    <string name="whatsnew_item_i18n_desc">Main UI now supports Chinese and English and follows the system language.</string>

