    <string name="user_notice_title">User Notice</string>
    <string name="user_notice_body">1. FloatAI supports Android 8.0+ (API 26+).\n\n2. The float window requires the Display over other apps permission.\n\n3. Process viewing and ATK elevated operations require at least one of: Shizuku, Dhizuku, or Root.\n\n4. The AI feature requires you to configure the provider API URL and key. This app does not store any model or chat data.\n\n5. Use this app in compliance with local laws and regulations.\n\n6. This app is open-source under the MIT License. Use at your own risk.</string>

    <string name="permission_notice_title">Permission Agreement</string>
    <string name="permission_notice_body">This app requests the following permissions:\n\n• Display over other apps — for the AI float window.\n• Foreground service (FOREGROUND_SERVICE / DATA_SYNC) — to keep the float window alive.\n• Post notifications (POST_NOTIFICATIONS) — for the float window service.\n• Internet (INTERNET) — to call the AI provider API.\n• Access network state (ACCESS_NETWORK_STATE) — to check network availability.\n\nElevated permissions:\n• Shizuku — ADB-level permissions for process view and ATK.\n• Dhizuku — alternative for non-root devices.\n• Root — full device control.\n\nPlease confirm that you understand the risks before granting any permission.</string>

    <string name="elevated_title">Choose a Grant Source</string>
    <string name="elevated_intro">To use ATK and process viewing, please grant at least one elevated permission:</string>
    <string name="elevated_shizuku">Shizuku</string>
    <string name="elevated_shizuku_desc">ADB-started service, no root required.</string>
    <string name="elevated_dhizuku">Dhizuku</string>
    <string name="elevated_dhizuku_desc">Device-owner based, no root alternative.</string>
    <string name="elevated_root">Root</string>
    <string name="elevated_root_desc">Full device control, requires su binary.</string>
    <string name="elevated_open">Open & Authorize</string>
    <string name="elevated_recheck">Re-detect</string>
    <string name="elevated_continue">Authorized, continue</string>
